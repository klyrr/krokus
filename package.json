{
  "name": "krokus",
  "version": "2.0.0",
  "description": "Provider for localization patterns and a number and currency formatter.",
  "keywords": [
    "localization",
    "l10n",
    "format",
    "numberformat",
    "numberFormat",
    "currencyformat",
    "currencyFormat",
    "locale"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klyrr/krokus.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "NODE_ENV=production npx rollup -c",
    "test": "vitest",
    "eslint": "npx eslint index.ts src/**",
    "format": "prettier --write .",
    "format:ci": "prettier --check src/**/*",
    "clean": "rm -rf dist/"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.36.0",
    "@typescript-eslint/parser": "8.36.0",
    "eslint": "9.30.1",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-prettier": "5.5.1",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "vite": "7.0.3",
    "vitest": "3.2.4"
  },
  "bugs": {
    "url": "https://github.com/klyrr/krokus/issues"
  },
  "source": "index.ts",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "author": "Tina Umlandt",
  "homepage": "https://github.com/klyrr/krokus#readme",
  "files": [
    "dist"
  ],
  "directories": {
    "test": "test"
  },
  "dependencies": {
    "fast-xml-parser": "5.2.5"
  }
}
